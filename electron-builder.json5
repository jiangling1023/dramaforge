{
  "appId": "com.dramaforge.app",
  "productName": "DramaForge",
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": [
    "electron/main.js",
    "electron/preload.js",
    "electron/node_modules/**/*",
    "web/dist/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DramaForge"
  }
}
