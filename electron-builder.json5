{
  "appId": "com.dramaforge.app",
  "productName": "DramaForge",
  "directories": {
    "output": "release"
  },
  "files": [
    "electron/**/*",
    "web/dist/**/*",
    "web/public/**/*"
  ],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "DramaForge"
  }
}
