{
  "name": "dramaforge",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["web", "server"],
  "scripts": {
    "dev:web": "cd web && npm run dev",
    "dev:server": "cd server && node src/index.mjs",
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:server\"",
    "build": "cd web && npm install && npm run build",
    "start": "cd server && node src/index.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
