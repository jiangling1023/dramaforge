{
  "appId": "com.dramaforge.app",
  "productName": "DramaForge",
  "directories": {
    "output": "../release"
  },
  "files": [
    "main.js",
    "preload.js",
    "node_modules/**/*"
  ],
  "win": {
    "target": ["nsis"],
    "icon": "resources/icon.ico",
    "sign": null,
    "signingHashAlgorithms": []
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true
  },
  "extraMetadata": {
    "main": "main.js"
  }
}
